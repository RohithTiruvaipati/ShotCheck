{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "target": "ESNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
